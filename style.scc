body {
    font-family: sans-serif;
    background-color: black;
    color:rgb(255, 255, 255);
}

nav a {
    font-size: 15px;
    color: rgb(255, 255, 255);
    border-radius: 15px;
    text-decoration: none;
    border:  2px solid rgb(255, 255, 255);
    margin: 50px;
    padding: 10px;
}

nav {
    padding: 20px;
    
}

header {
    color: white;
    padding: 10px;
}

header a {
    color: red;
    border-radius: 100px;
    text-decoration: none;
    border:  2px solid red;
    margin: 10px;
    padding: 5px;
   
}

h1 {
   text-align: center;
    color: red;
    border-radius: 10px;
    text-decoration: none;
    border:  2px solid red;
    margin: 10px;
    padding: 5px;
 }

 footer {
    background-color: red;
    color: black;
    font-size: 20px;
 }

select {
    background-color: black;
    color: red;
}

.all {
    background-color: red;
}

